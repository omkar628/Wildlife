# Copy this file to .env and adjust if needed.
# All paths are relative to the project root unless they are absolute.

WI_CONFIDENCE_AUTO_ACCEPT=0.60
WI_CONFIDENCE_DETECT_MIN=0.15

# Leave blank to auto-discover:
#   1) models/detector/best.pt
#   2) ./best.pt  (current location of your trained weights)
WI_DETECTOR_MODEL_PATH=

# Leave blank to auto-discover ./tiger_reid_arcface.pth etc.
# Those ATRW assets are inspected only. They are never used as production IDs.
WI_REID_WEIGHTS_PATH=
WI_REID_INDEX_PATH=
WI_REID_METADATA_PATH=

# MegaDescriptor local Re-ID (production identity space is T001+)
WI_REID_ENABLED=true
WI_REID_MODEL_ID=BVRA/MegaDescriptor-S-224
WI_REID_MODEL_PATH=
WI_REID_DEVICE=auto
# Provisional: auto-assign only at very high cosine. See config/settings.yaml.
WI_REID_MATCH_THRESHOLD=0.90
WI_REID_REVIEW_THRESHOLD=0.55
WI_REID_MIN_MARGIN=0.05

WI_DATABASE_PATH=database/wildlife.db
WI_CROPS_DIR=data/crops
WI_LOGS_DIR=logs

WI_DETECTOR_BATCH_SIZE=8
WI_DETECTOR_IMGSZ=640
WI_DETECTOR_DEVICE=auto

# Leave blank to auto-discover:
#   1) models/gnn/gnn_model_v3_optimized_best.pt
#   2) ./gnn_model_v3_optimized_best.pt
WI_GNN_WEIGHTS_PATH=
WI_GNN_DEVICE=auto

WI_HOST=127.0.0.1
WI_PORT=8000
