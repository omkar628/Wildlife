# Copy this file to .env and adjust if needed.
# All paths are relative to the project root unless they are absolute.

WI_CONFIDENCE_AUTO_ACCEPT=0.60
WI_CONFIDENCE_DETECT_MIN=0.15

# Leave blank to auto-discover:
#   1) models/detector/best.pt
#   2) ./best.pt  (current location of your trained weights)
WI_DETECTOR_MODEL_PATH=

# Leave blank to auto-discover ./tiger_reid_arcface.pth etc.
WI_REID_WEIGHTS_PATH=
WI_REID_INDEX_PATH=
WI_REID_METADATA_PATH=

WI_DATABASE_PATH=database/wildlife.db
WI_CROPS_DIR=data/crops
WI_LOGS_DIR=logs

WI_DETECTOR_BATCH_SIZE=8
WI_DETECTOR_IMGSZ=640
WI_DETECTOR_DEVICE=auto

WI_HOST=127.0.0.1
WI_PORT=8000
